{
  "name": "@wrappedbulls/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the WrappedBulls protocol family on Solana. Wrap any pump.fun token into an NFT layer; read on-chain state; build deploy/wrap/unwrap/claim_treasury transactions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wrappedbulls/wrappedbulls.git",
    "directory": "sdk"
  },
  "homepage": "https://wrappedbulls.com",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "solana",
    "wrappedbulls",
    "pump.fun",
    "erc404",
    "nft",
    "wrap",
    "factory"
  ],
  "peerDependencies": {
    "@coral-xyz/anchor": ">=0.30.0 <2.0.0",
    "@solana/spl-token": ">=0.4.0",
    "@solana/web3.js": ">=1.95.0"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
