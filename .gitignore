# Anchor / Rust build artifacts
target/
**/target/
Cargo.lock.bak

# Solana keypairs (NEVER commit)
**/*-keypair.json
**/wallet-keypair.json
**/id.json
*.pem

# Node
node_modules/
**/node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
build/

# Env files (may contain RPC keys)
.env
.env.local
.env.production
.env.*.local
!.env.example

# Generated samples (large, regenerable)
samples/
!samples/showcase/index.html
!samples/mascots/index.html

# Scratch trait-preview HTML (regenerable from cranker scripts)
cranker/*_preview.html
cranker/all_traits.html

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Anchor IDL/types are committed (consumers need them)
# but not the deploy keypair
target/deploy/*-keypair.json

# Logs
*.log
deploy.log
install.log

# Local TypeScript build output
*.tsbuildinfo
next-env.d.ts

# Runtime launch-state file (mutable; flipped by the operator at launch).
# Production points LAUNCH_STATE_FILE at /var/lib/<slug>/state.json.
# launch-state.example.json IS committed as the template.
web/config/launch-state.json

# Generated from config/launch.toml by scripts/sync_web_config.mjs.
# Regenerated by the predev/prebuild/pretypecheck npm hooks — never
# hand-edit, never rely on a committed copy.
web/lib/launch-config.generated.ts

# Operator-session advisory lock (scripts/no_concurrent_agents.sh).
.operator-session.lock
