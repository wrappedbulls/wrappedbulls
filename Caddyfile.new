# WrappedBulls reverse proxy with auto-TLS via ZeroSSL.
# Switched from Lets Encrypt due to LE outage 2026-05-08.
# ZeroSSL also issues real, browser-trusted DV certs.
{
  acme_ca https://acme.zerossl.com/v2/DV90
  email degencapital999@gmail.com
}

# WrappedBulls live site
#   - /api/*  reverse_proxy to wrappedbulls-web (Next.js on :3001)
#   - everything else: static prelaunch HTML in /var/www/wrappedbulls
wrappedbulls.com, www.wrappedbulls.com {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    -Server
  }

  # API layer: blue/green Next.js (blue=3001, green=3002).
  # lb_policy first: blue is preferred; green takes over only when blue
  # fails health checks. Crash or deploy of blue is a sub-second failover
  # to green with zero dropped requests.
  handle /api/* {
    reverse_proxy 127.0.0.1:3001 127.0.0.1:3002 {
      lb_policy first
      health_uri /api/health
      health_interval 5s
      health_timeout 3s
      header_up Host {host}
      header_up X-Forwarded-Proto https
    }
  }

  # Functional wallet routes: /wrap, /unwrap, /gallery, /bull/<tier>, /wallet/<addr>
  # All require client-side wallet connect + chain reads. Plus /_next/*
  # for the Next.js client bundle assets. Active health check (/api/health)
  # alone governs failover; passive fail_duration/max_fails are intentionally
  # omitted so a misbehaving client cannot mark a healthy upstream down.
  @walletRoutes path /wrap /wrap/* /unwrap /unwrap/* /gallery /gallery/* /deflation /deflation/* /bull/* /wallet/* /_next/*
  handle @walletRoutes {
    reverse_proxy 127.0.0.1:3001 127.0.0.1:3002 {
      lb_policy first
      health_uri /api/health
      health_interval 5s
      health_timeout 3s
      header_up Host {host}
      header_up X-Forwarded-Proto https
    }
  }

  # Redirect stale .html bookmarks to functional non-.html routes
  redir /wrap.html /wrap permanent
  redir /unwrap.html /unwrap permanent
  redir /gallery.html /gallery permanent

  # Static site: terminal aesthetic HTML
  handle {
    root * /var/www/wrappedbulls
    try_files {path} {path}.html {path}/
    file_server
  }

  handle_errors {
    @404 expression {err.status_code} == 404
    rewrite @404 /404.html
    root * /var/www/wrappedbulls
    file_server
  }

  log {
    output file /var/log/caddy/wrappedbulls.log
    format json
  }
}

# Catch-all for direct-IP hits or unknown hosts -> brand site
:80 {
  redir https://wrappedbulls.com{uri} permanent
}
